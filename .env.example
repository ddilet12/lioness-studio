# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-01
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ApiPay.kz — independent third-party service on top of a merchant's own Kaspi Pay account.
# NOT an official Kaspi integration. https://apipay.kz/for-ai
# API key: dashboard > Settings > Подключение (shown once at creation).
APIPAY_API_KEY=
# Optional override; defaults to https://api.apipay.kz/api/v1 in code.
APIPAY_BASE_URL=
# Webhook secret: dashboard > Settings > Подключение, when you add/edit the webhook URL
# (set it to https://<your-domain>/api/webhooks/apipay). Also shown once.
APIPAY_WEBHOOK_SECRET=
