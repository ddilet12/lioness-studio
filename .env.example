# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-01
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ApiPay.kz — independent third-party service on top of a merchant's own Kaspi Pay account (NOT an official
# Kaspi integration). With APIPAY_API_KEY set, checkout opens the Kaspi payment form; without it, checkout
# goes to Shopify. https://apipay.kz/for-ai
# API key: ApiPay cabinet > Settings > Подключение (shown once at creation).
APIPAY_API_KEY=
# Set to "false" to switch Kaspi checkout off without removing the key.
APIPAY_ENABLED=
# Webhook secret(s) for /api/webhooks/apipay — comma-separated if several ApiPay keys point at this site.
APIPAY_WEBHOOK_SECRET=
# Public address used for ApiPay's "back to the shop" buttons (defaults to https://lionessdress.com).
SITE_URL=
